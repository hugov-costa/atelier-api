APP_NAME=atelie
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atelier
DB_USERNAME=atelier
DB_PASSWORD=atelier

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

MAIL_MAILER=mailjet
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILJET_MODE=api
MAILJET_APIKEY=
MAILJET_APISECRET=
MAILJET_ENDPOINT=default

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=atelier
MINIO_SECRET_KEY=atelier_secret
MINIO_REGION=us-east-1
MINIO_PRIVATE_BUCKET=private
MINIO_PUBLIC_BUCKET=public
MINIO_PUBLIC_URL=http://localhost:9000/public

AUDIT_CONSOLE=false
AUDIT_RETENTION_DAYS=180
# Keep audit writes synchronous so the accountability trail is persisted in the
# request that caused the change. Only enable for high write-volume deploys that
# run a reliable queue worker, accepting that a stalled worker delays the trail.
AUDIT_QUEUE=false

QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600

# Issued API tokens expire after this many minutes (default 14 days, matching the
# auth cookie lifetime). A finite value bounds the blast radius of a leaked token.
SANCTUM_TOKEN_EXPIRATION=20160

# Observability tooling captures request/query payloads (potential PII), so it is
# off by default and must be explicitly enabled per environment.
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
PULSE_INGEST_DRIVER=redis
PULSE_STORAGE_KEEP="7 days"

AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_LIFETIME=20160
# Local dev runs over HTTP, where browsers drop `Secure` cookies; keep this false locally.
# This flag only applies outside production: when APP_ENV=production the cookie is ALWAYS
# Secure regardless of this value (see config/auth.php). For a cross-site SPA (front and
# API on different domains) also set AUTH_COOKIE_SAME_SITE=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Lifetime (minutes) of the set-password onboarding token
SET_PASSWORD_TOKEN_EXPIRATION=1440
