# Production template. Copy to .env on the server (or inject via your orchestrator/secrets
# manager) and replace every <placeholder>. Never commit the filled-in file.
# Values that differ from .env.example for security/perf reasons are flagged with [PROD].

APP_NAME=atelier
APP_ENV=production                 # [PROD] enables production hardening (forces Secure cookie)
APP_KEY=                           # [PROD] generate once: php artisan key:generate --force
APP_DEBUG=false                    # [PROD] never true in production (leaks stack traces)
APP_URL=https://api.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                  # [PROD] avoid debug-level noise/leakage

DB_CONNECTION=pgsql
DB_HOST=<db-host>
DB_PORT=5432
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<strong-db-password>   # [PROD] strong, unique, from a secret store

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true               # [PROD] encrypt session payloads
SESSION_PATH=/
SESSION_DOMAIN=null                # set to a shared parent domain only for subdomain SSO

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=<redis-host>
REDIS_PASSWORD=<redis-password>    # [PROD] require auth on Redis
REDIS_PORT=6379

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true                  # [PROD] generate https:// URLs (TLS terminated up front)

MAIL_MAILER=mailjet
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILJET_MODE=api
MAILJET_APIKEY=<mailjet-key>
MAILJET_APISECRET=<mailjet-secret>
MAILJET_ENDPOINT=default

MINIO_ENDPOINT=https://<object-storage-endpoint>
MINIO_ACCESS_KEY=<storage-access-key>
MINIO_SECRET_KEY=<storage-secret-key>
MINIO_REGION=us-east-1
MINIO_PRIVATE_BUCKET=private
MINIO_PUBLIC_BUCKET=public
MINIO_PUBLIC_URL=https://storage.your-domain.com/public

AUDIT_CONSOLE=false
# Retention windows (days) for the change-audit trail and impersonation access log.
# Default ~6 months: balances accountability/incident investigation with data
# minimisation. The audit trail logs only model changes (never reads or logins).
AUDIT_RETENTION_DAYS=180
IMPERSONATION_RETENTION_DAYS=180
# Days a soft-deleted account stays recoverable before its personal data is
# anonymised by accounts:anonymize-trashed (data-minimisation).
ACCOUNT_ANONYMIZE_TRASHED_DAYS=30

QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600

TELESCOPE_ENABLED=false            # [PROD] Telescope must be off in production
PULSE_ENABLED=true                 # admin-gated; disable if you don't need it
PULSE_INGEST_DRIVER=redis
PULSE_STORAGE_KEEP="7 days"

AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_LIFETIME=20160
AUTH_COOKIE_SECURE=true            # [PROD] forced true anyway when APP_ENV=production
# Same site (front served from a subdomain of the API): keep "lax".
# Cross-site (front on a different registrable domain): set "none" (requires HTTPS on both).
AUTH_COOKIE_SAME_SITE=lax

CORS_ALLOWED_ORIGINS=https://app.your-domain.com   # [PROD] real front origin(s), never localhost or *
FRONTEND_URL=https://app.your-domain.com
