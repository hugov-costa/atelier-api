{
    "config": {
        "fail-on-first-error": true,
        "run-mode": "docker",
        "run-exec": "docker compose exec -T app"
    },
    "hooks": {
        "pre-commit": {
            "enabled": true,
            "actions": [
                {
                    "action": "sh docker/git-hooks/quality-gate.sh pint"
                },
                {
                    "action": "sh docker/git-hooks/quality-gate.sh phpstan"
                },
                {
                    "action": "sh docker/git-hooks/quality-gate.sh test"
                }
            ]
        },
        "commit-msg": {
            "enabled": true,
            "actions": [
                {
                    "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
                    "options": {
                        "regex": "#\\A(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\\([a-z0-9._/-]+\\))?!?: .{1,72}(\\n|$)#",
                        "error": "Commit message must follow Conventional Commits: '<type>[(scope)][!]: <subject>' with a lowercase type and a subject of at most 72 characters. Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test."
                    }
                }
            ]
        }
    }
}
